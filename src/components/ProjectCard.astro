---
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	class?: string;
	eager?: boolean;
	index?: number;
	/** Affiche une pastille « Voir le projet » plus visible. */
	featured?: boolean;
}

const { project, class: className = '', eager = false, index = 0, featured = false } = Astro.props;
const aspect = project.orientation === 'vertical' ? 'aspect-[9/16]' : 'aspect-video';
---

<a
	href={`/work/${project.slug}`}
	class:list={['group block', className]}
	data-reveal
	style={`--reveal-delay:${(index % 3) * 80}ms`}
>
	<div class:list={['card-media relative', aspect]}>
		<img
			src={project.poster}
			alt={`${project.title}${project.channel ? `, montage de ${project.channel}` : ''}`}
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
			class="h-full w-full object-cover"
		/>
		<div class="card-sheen"></div>
		<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/5 to-transparent"></div>

		<span class="absolute left-4 top-4">
			<span class="tag">{project.category}</span>
		</span>

		<span
			class:list={[
				'absolute bottom-4 right-4 z-10 flex items-center gap-2 rounded-full bg-cream-50/90 px-4 py-2 text-xs font-medium text-ink backdrop-blur transition-all duration-500 group-hover:bg-amber',
				featured ? 'opacity-100' : 'opacity-0 translate-y-2 group-hover:translate-y-0 group-hover:opacity-100',
			]}
		>
			<Icon name="lucide:play" class="size-3.5" aria-hidden="true" />
			Voir le projet
		</span>
	</div>

	<div class="mt-4 flex items-start justify-between gap-4">
		<div>
			<h3 class="font-display text-xl leading-snug transition-colors duration-300 group-hover:text-terracotta md:text-2xl">
				{project.title}
			</h3>
			<p class="mt-1 text-sm text-muted">{project.channel ? `${project.channel} · ${project.format}` : project.format}</p>
		</div>
		<span class="mt-1 text-muted transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-terracotta" aria-hidden="true">
			<Icon name="lucide:arrow-up-right" class="size-5" />
		</span>
	</div>
</a>
