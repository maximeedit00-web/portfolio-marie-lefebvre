---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { introVideoId } from '../data/projects';
import { pages } from '../data/pages';
---

<Base
	title="À propos"
	description="Je suis Marie Lefebvre, monteuse vidéo. Diplômée en communication, passionnée de montage, de musique, d’art et de cinéma."
>
	<PageHero
		script={pages.about.hero_script}
		eyebrow="À propos"
		title={pages.about.hero_title}
		description={pages.about.hero_desc}
	/>

	<section class="section">
		<div class="shell grid items-start gap-14 lg:grid-cols-2">
			<div class="lg:sticky lg:top-28" data-reveal="left">
				<div class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-black shadow-[var(--shadow-soft)]">
					<iframe
						class="aspect-video w-full"
						src={`https://www.youtube-nocookie.com/embed/${introVideoId}?rel=0&modestbranding=1`}
						title="Je suis monteuse vidéo ! Présentation de Marie Lefebvre"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
						referrerpolicy="strict-origin-when-cross-origin"
					></iframe>
				</div>
				<p class="mt-3 text-sm text-muted">Ma vidéo de présentation.</p>
			</div>

			<div class="max-w-2xl">
				<div class="space-y-6 text-lg text-cocoa" data-reveal>
					<p>{site.texts.aboutP1}</p>
					<p>{site.texts.aboutP2}</p>
					<p>{site.texts.aboutP3}</p>
				</div>

				<dl class="mt-12 grid gap-x-8 gap-y-6 border-t border-line pt-10 sm:grid-cols-2" data-reveal>
					<div>
						<dt class="text-xs uppercase tracking-[0.18em] text-muted">Formation</dt>
						<dd class="mt-2 font-display text-xl">Diplômée en communication</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-[0.18em] text-muted">Domaines</dt>
						<dd class="mt-2 font-display text-xl">Montage · Graphisme · Communication</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-[0.18em] text-muted">Expériences</dt>
						<dd class="mt-2 font-display text-xl">Stages en mairie & en association</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-[0.18em] text-muted">Contact</dt>
						<dd class="mt-2">
							<a href={`mailto:${site.email}`} class="link-underline font-display text-xl">{site.email}</a>
						</dd>
					</div>
				</dl>

				<div class="mt-10 flex flex-wrap gap-3" data-reveal>
					<a href="/work" class="btn btn-dark">
						Voir mes projets
						<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
					</a>
					<a href="/contact" class="btn btn-ghost">Me contacter</a>
				</div>
			</div>
		</div>
	</section>

	<section class="on-forest grain relative overflow-hidden section">
		<div class="halo anim-glow" style="width:30rem;height:30rem;background:var(--color-amber);top:-8rem;right:-8rem;opacity:0.35"></div>
		<div class="shell relative">
			<div class="max-w-2xl" data-reveal>
				<p class="eyebrow">Comment je travaille</p>
				<h2 class="mt-4 font-display text-4xl md:text-5xl">{pages.about.process_title}</h2>
			</div>
			<div class="mt-14 grid gap-10 md:grid-cols-3">
				<div data-reveal>
					<span class="font-display text-sm text-amber-soft">01</span>
					<h3 class="mt-4 font-display text-2xl">On échange</h3>
					<p class="mt-3 text-sm text-muted-dark">Votre idée, votre audience, vos rushes et l’objectif de la vidéo.</p>
				</div>
				<div data-reveal style="--reveal-delay:90ms">
					<span class="font-display text-sm text-amber-soft">02</span>
					<h3 class="mt-4 font-display text-2xl">Je monte</h3>
					<p class="mt-3 text-sm text-muted-dark">Sélection, rythme, narration et habillage, jusqu’à une première version.</p>
				</div>
				<div data-reveal style="--reveal-delay:180ms">
					<span class="font-display text-sm text-amber-soft">03</span>
					<h3 class="mt-4 font-display text-2xl">Je livre</h3>
					<p class="mt-3 text-sm text-muted-dark">Vos retours, une dernière passe, et la vidéo est prête à publier.</p>
				</div>
			</div>
			<div class="mt-14" data-reveal>
				<a href="/contact" class="btn btn-primary">
					Discutons de votre projet
					<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
				</a>
			</div>
		</div>
	</section>
</Base>
