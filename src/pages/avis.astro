---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
---

<Base
	title="Avis"
	description="Les retours des créateurs et des structures avec qui j’ai travaillé."
>
	<PageHero
		script="Témoignages clients"
		eyebrow="Avis"
		title="Ce qu’on dit de mon travail."
		description="Les retours de celles et ceux avec qui j’ai collaboré : créateurs YouTube, associations, structures locales."
	/>

	<section class="section">
		<div class="shell">
			{reviews.length > 0 ? (
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{reviews.map((review, i) => <ReviewCard review={review} index={i} />)}
				</div>
			) : (
				<div class="mx-auto max-w-2xl rounded-[var(--radius-card)] border border-line bg-cream-50 p-10 text-center shadow-[var(--shadow-soft)] md:p-14" data-reveal>
					<span class="mx-auto flex size-14 items-center justify-center rounded-full bg-ink text-amber-soft">
						<Icon name="lucide:message-square-quote" class="size-6" aria-hidden="true" />
					</span>
					<h2 class="mt-7 font-display text-3xl text-ink md:text-4xl">Les avis arrivent bientôt.</h2>
					<p class="mx-auto mt-4 max-w-md text-cocoa">
						Je rassemble ici les témoignages des personnes avec qui j’ai travaillé. En attendant,
						mes projets parlent pour moi, et je serais ravie de vous partager des références.
					</p>
					<div class="mt-8 flex flex-wrap justify-center gap-3">
						<a href="/work" class="btn btn-dark">
							Voir mes projets
							<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
						</a>
						<a href="/contact" class="btn btn-ghost">Demander des références</a>
					</div>
				</div>
			)}

			<div class="mx-auto mt-16 max-w-2xl text-center" data-reveal>
				<p class="font-display text-2xl md:text-3xl">Vous avez travaillé avec moi ?</p>
				<p class="mt-4 text-cocoa">
					Votre retour m’aide à progresser et aide les prochains projets à se lancer en confiance.
				</p>
				<a href={`mailto:${site.email}`} class="btn btn-dark mt-8">
					<Icon name="lucide:mail" class="size-4" aria-hidden="true" />
					M’envoyer mon témoignage
				</a>
			</div>
		</div>
	</section>

	<section class="on-forest grain relative overflow-hidden section">
		<div class="halo anim-glow" style="width:30rem;height:30rem;background:var(--color-terracotta);bottom:-12rem;left:-8rem;opacity:0.4"></div>
		<div class="shell relative text-center">
			<h2 class="mx-auto max-w-2xl font-display text-3xl md:text-5xl" data-reveal>
				À vous de donner votre avis.
			</h2>
			<div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal>
				<a href="/work" class="btn btn-primary">
					Voir mes projets
					<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
				</a>
				<a href="/contact" class="btn btn-ghost">Me contacter</a>
			</div>
		</div>
	</section>
</Base>
