---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { pages } from '../data/pages';
---

<Base
	title="Mentions légales"
	description="Mentions légales du site de Marie Lefebvre, monteuse vidéo."
>
	<PageHero eyebrow="Informations" title="Mentions légales." />

	<section class="section">
		<div class="shell max-w-3xl space-y-10 text-cocoa">
			{pages.mentions.sections.map((s) => (
				<div>
					<h2 class="font-display text-2xl text-ink">{s.titre}</h2>
					{s.texte.split('\n').map((line) => (
						<p class="mt-3">{line}</p>
					))}
				</div>
			))}
		</div>
	</section>
</Base>
