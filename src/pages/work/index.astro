---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';
import { projects, categories, featuredProject } from '../../data/projects';

const rest = projects.filter((p) => p.slug !== featuredProject.slug);
const montages = rest.filter((p) => p.orientation !== 'vertical');
const formatsCourts = rest.filter((p) => p.orientation === 'vertical');

const formats = [
	{ title: 'Montage long', text: 'Des vidéos narratives, construites pour tenir dans la durée.' },
	{ title: 'Formats courts', text: 'Shorts, Reels et TikToks, pensés pour le vertical.' },
	{ title: 'Vlog', text: 'Des vlogs au ton léger, montés au rythme.' },
	{ title: 'Créateurs', text: 'Des montages pour d’autres chaînes YouTube.' },
	{ title: 'Communication', text: 'Des vidéos au service d’un message.' },
];
---

<Base
	title="Montage"
	description="Mes montages : formats courts, montages longs, storytelling, vidéos pour créateurs et communication."
>
	<PageHero
		script="Mon métier"
		eyebrow="Montage vidéo"
		title="Quelques montages que j’ai réalisés."
		description="Formats courts, montages longs, storytelling et vidéos pour d’autres créateurs. D’autres projets arrivent régulièrement."
	/>

	<section class="pt-14 md:pt-20">
		<div class="shell grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
			{formats.map((f, i) => (
				<div data-reveal style={`--reveal-delay:${i * 70}ms`}>
					<h2 class="font-display text-lg">{f.title}</h2>
					<p class="mt-2 text-sm text-muted">{f.text}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<!-- Filtres -->
			<div class="flex flex-wrap gap-2" data-reveal role="group" aria-label="Filtrer les projets par catégorie">
				{categories.map((category, i) => (
					<button
						type="button"
						data-filter={category}
						class:list={['filter-chip', i === 0 && 'is-active']}
						aria-pressed={i === 0 ? 'true' : 'false'}
					>
						{category}
					</button>
				))}
			</div>

			<!-- Projet mis en avant -->
			<article class="mt-12 grid gap-8 lg:grid-cols-[1.35fr_1fr] lg:items-center" data-project-item data-category={featuredProject.category} data-reveal>
				<a href={`/work/${featuredProject.slug}`} class="card-media group relative block aspect-video">
					<img
						src={featuredProject.poster}
						alt={`${featuredProject.title}${featuredProject.channel ? `, montage de ${featuredProject.channel}` : ''}`}
						loading="eager"
						decoding="async"
						class="h-full w-full object-cover"
					/>
					<div class="card-sheen"></div>
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/65 to-transparent"></div>
					<span class="absolute left-4 top-4"><span class="tag">{featuredProject.category}</span></span>
					<span class="absolute right-4 top-4 flex size-11 items-center justify-center rounded-full bg-cream-50/90 text-ink backdrop-blur transition-colors group-hover:bg-amber" aria-hidden="true">
						<Icon name="lucide:play" class="size-4 translate-x-[1px]" />
					</span>
				</a>
				<div>
					<span class="eyebrow">Projet à la une</span>
					<h2 class="mt-5 font-display text-3xl md:text-4xl">{featuredProject.title}</h2>
					<p class="mt-4 text-muted">{featuredProject.channel ? `${featuredProject.channel} · ${featuredProject.format}` : featuredProject.format}</p>
					<p class="mt-5 max-w-md text-cocoa">{featuredProject.description}</p>
					<a href={`/work/${featuredProject.slug}`} class="btn btn-dark mt-8">
						Voir le projet
						<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
					</a>
				</div>
			</article>

			<!-- Montages (format horizontal) -->
			<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-12">
				{montages.map((project, i) => (
					<div class="lg:col-span-4" data-project-item data-category={project.category}>
						<ProjectCard project={project} index={i} />
					</div>
				))}
			</div>

			<!-- Formats courts (format vertical) -->
			<div class="mt-16" data-shorts data-reveal>
				<p class="eyebrow">Formats courts</p>
				<div class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
					{formatsCourts.map((project, i) => (
						<div data-project-item data-category={project.category}>
							<ProjectCard project={project} index={i} />
						</div>
					))}
				</div>
			</div>

			<p class="mt-12 text-center text-sm text-muted" data-reveal>D’autres projets sont en cours de montage.</p>
		</div>
	</section>

	<!-- Contact -->
	<section class="on-forest grain relative overflow-hidden section">
		<div class="halo anim-glow" style="width:30rem;height:30rem;background:var(--color-terracotta);bottom:-12rem;right:-8rem;opacity:0.4"></div>
		<div class="shell relative text-center">
			<h2 class="mx-auto max-w-2xl font-display text-3xl md:text-5xl" data-reveal>
				Un projet en tête ? Je peux m’en occuper.
			</h2>
			<div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal>
				<a href="/contact" class="btn btn-primary">
					Me contacter
					<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
				</a>
				<a href="/services" class="btn btn-ghost">Voir les services</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.filter-chip {
		border: 1px solid var(--color-line);
		background: var(--color-cream-50);
		color: var(--color-cocoa);
		border-radius: var(--radius-pill);
		padding: 0.55rem 1.1rem;
		font-size: 0.82rem;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
	}
	.filter-chip:hover {
		border-color: var(--color-terracotta);
		color: var(--color-terracotta);
		transform: translateY(-1px);
	}
	.filter-chip.is-active {
		background: var(--color-terracotta);
		border-color: var(--color-terracotta);
		color: var(--color-cream-50);
	}
</style>

<script>
	function initFilters() {
		const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
		const items = document.querySelectorAll<HTMLElement>('[data-project-item]');
		if (chips.length === 0) return;

		function apply(filter: string) {
			items.forEach((item) => {
				const cat = item.getAttribute('data-category');
				const show = filter === 'Tous' || cat === filter;
				item.style.display = show ? '' : 'none';
			});
			document.querySelectorAll<HTMLElement>('[data-shorts]').forEach((sec) => {
				const anyVisible = [...sec.querySelectorAll<HTMLElement>('[data-project-item]')].some(
					(el) => el.style.display !== 'none',
				);
				sec.style.display = anyVisible ? '' : 'none';
			});
		}

		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				chips.forEach((c) => {
					c.classList.remove('is-active');
					c.setAttribute('aria-pressed', 'false');
				});
				chip.classList.add('is-active');
				chip.setAttribute('aria-pressed', 'true');
				apply(chip.getAttribute('data-filter') || 'Tous');
			});
		});
	}

	initFilters();
	document.addEventListener('astro:page-load', initFilters);
</script>
