---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { miniatures, dessins, type Graphic } from '../data/graphics';
import { pages } from '../data/pages';

const cartes: { titre: string; sous: string; items: Graphic[]; ratio: string; contain: boolean }[] = [
	{ titre: pages.graphisme.mini_title, sous: pages.graphisme.mini_sub, items: miniatures, ratio: 'aspect-video', contain: false },
	{ titre: pages.graphisme.dessin_title, sous: pages.graphisme.dessin_sub, items: dessins, ratio: 'aspect-[4/5]', contain: true },
];
---

<Base
	title="Graphisme"
	description="Mes créations graphiques : miniatures YouTube, dessins et illustrations."
>
	<PageHero
		script={pages.graphisme.hero_script}
		eyebrow="Graphisme"
		title={pages.graphisme.hero_title}
		description={pages.graphisme.hero_desc}
	/>

	{cartes.map((carte, ci) => (
		<section class:list={['section', ci > 0 && 'border-t border-line bg-cream-50']}>
			<div class="shell">
				<div class="max-w-2xl" data-reveal>
					<p class="eyebrow">{carte.titre}</p>
					<h2 class="mt-4 font-display text-4xl md:text-5xl">{carte.sous}</h2>
				</div>

				<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{carte.items.map((g, i) => (
						<figure class="group" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
							<div class:list={['card-media relative', carte.ratio, 'bg-white']}>
								<img
									src={g.poster}
									alt={g.title || carte.titre}
									loading="lazy"
									decoding="async"
									class:list={['h-full w-full', carte.contain ? 'object-contain' : 'object-cover']}
								/>
								<div class="card-sheen"></div>
							</div>
							{g.title && (
								<figcaption class="mt-3">
									<h3 class="font-display text-lg">{g.title}</h3>
									{g.description && <p class="text-sm text-muted">{g.description}</p>}
								</figcaption>
							)}
						</figure>
					))}
				</div>
			</div>
		</section>
	))}

	<section class="on-forest grain relative overflow-hidden section">
		<div class="halo anim-glow" style="width:30rem;height:30rem;background:var(--color-terracotta);bottom:-12rem;right:-8rem;opacity:0.4"></div>
		<div class="shell relative text-center">
			<h2 class="mx-auto max-w-2xl font-display text-3xl md:text-5xl" data-reveal>
				{pages.graphisme.cta_title}
			</h2>
			<div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal>
				<a href="/contact" class="btn btn-primary">
					Me contacter
					<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
				</a>
				<a href="/comm" class="btn btn-ghost">Voir mes affiches</a>
			</div>
		</div>
	</section>
</Base>
